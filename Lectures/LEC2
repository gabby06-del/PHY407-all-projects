def double_nonvectorized(array): 
    doubled = array.copy()
    for i in range(len(array)):
        doubled[i] = array[i] *2 
    return doubled

def double_vectorized(array):
    return array*2

import numpy as np 
import time

N=1000
A = np.random.random((N, N))

t= time.time()
B = double_nonvectorized(A)
t1= time.time()
print('exec time of non vector code in s: ', t1-t)

t= time.time()
double_vectorized(A)
t1 = time.time()
print('exec time of vector code in s: ', t1-t)

