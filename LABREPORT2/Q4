def eqn(x, c):
    return 1 - np.exp(-c*x)

def relax(c, x0=1.0, err_tol=1e-6):
    x = x0
    iterations = 0
    while True:
        x_new = eqn(x, c)
        iterations += 1
        if abs(x_new - x) < err_tol:
            return x_new, iterations
