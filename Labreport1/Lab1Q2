#QUESTION2 EXPLORING ROUNDOFF ERROR

#Q2(a)
import numpy as np 
import matplotlib.pyplot as plt 

def P(u_set):
    return (1-u_set)**8 
def Q(u_set):
    return (1 - 8*u_set + 28*u_set**2 - 56*u_set**3 + 70*u_set**4
            - 56*u_set**5 + 28*u_set**6 - 8*u_set**7 + u_set**8)
#using bounds set in assignment/lab report guide
#i wasnt sure which type of array was best fit for this report so I did both linspace and np.sort
set_linspace = np.linspace(0.97, 1.02, 500)
set_uniform_random = np.sort(np.random.uniform(0.97, 1.02, 500))

#figures for lab report 
plt.figure()
plt.plot(set_linspace, P(set_uniform_random))
plt.ylabel("P(u)")
plt.xlabel("U value: 0.98<U<1.02")
plt.title("P(U) for 0.97< U < 1.02 for nplinspace")
plt.savefig("P(U) for 0.97< U < 1.02 for nplinspace.png")
plt.show()


plt.figure()
plt.plot(set_linspace, Q(set_linspace))
plt.ylabel("Q(u)")
plt.xlabel("U value: 0.98<U<1.02")
plt.title("Q(U) for 0.97< U < 1.02 for nplinspace")
plt.savefig("Q(U) for 0.97< U < 1.02 for nplinspace.png")
plt.show()


plt.figure()
plt.plot(set_uniform_random, P(set_uniform_random))
plt.ylabel("P(u)")
plt.xlabel("U value: 0.98<U<1.02")
plt.title("P(U) for 0.97< U < 1.02 for nprand")
plt.savefig("P(U) for 0.97< U < 1.02 for nprand.png")
plt.show()


plt.figure()
plt.plot(set_uniform_random, Q(set_uniform_random))
plt.ylabel("Q(u)")
plt.xlabel("U value: 0.98<U<1.02")
plt.title("Q(U) for 0.97< U < 1.02 for nprand")
plt.savefig("Q(U) for 0.97< U < 1.02 for nprand.png")
plt.show()

#Question 2(b)
#did just linspace for this one
set_linspace_2b = np.linspace(0.97, 1.02, 500)

def f(u_set):
    return (u_set**8 )/((u_set**4)*(u_set**4))

std_dev= np.std(f(set_linspace_2b))
print("Numerical output for std dev for f(set_linspace):",std_dev)

#should result in a noisy graph around 1 to show roundoff error present 
plt.figure()
plt.plot(set_linspace_2b, f(set_linspace_2b)-1)
plt.ylabel("f(u)")
plt.xlabel("U value: 0.97<U<1.02")
plt.title("f(U)-1 for 0.97< U < 1.02")
plt.savefig("f(U)-1 for 0.97< U < 1.02.png")
plt.show()
