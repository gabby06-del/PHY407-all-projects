def std_err_formula_2 (dataset):
    n = len(dataset)
    mean_val= (np.sum(dataset)/n)
    var_sum= np.sum((dataset-mean_val)**2)

    if var_sum <= 0:
        return 0
    return sqrt((var_sum)/(n-1))

