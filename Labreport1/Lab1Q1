#2. using Eqn.(3) from assignment
def std_err_formula_3 (dataset):
    n = len(dataset)
    mean_val= ((np.sum(dataset)/n))
    sum_of_squares = np.sum(dataset**2) 
    variance = ((sum_of_squares- n*(mean_val)**2)) / (n-1)
    if variance <= 0:
        return 0
    return sqrt(variance)
