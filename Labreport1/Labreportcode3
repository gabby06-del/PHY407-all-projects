#QUESTION 3: TRAPEZOIDAL AND SIMPSON'S RULE FOR INTEGRATION

#Q3(a): The answer is pi or roughly 3.1416 (used wolfram alpha)
#Q3(b)
import numpy as np
import time

true_val = np.pi
a = 0
b = 1
target_err = 1e-9

def func(x):
    return 4 / (1 + x**2)
#Used init in the variable names to differentiate those with N=4 and the further calculations
N_init= 4
stepsize_h_init=(b - a) / N_init
x_init =np.linspace(a, b, N_init+1)
y_init =func(x_init)

I_trap_init= (stepsize_h_init / 2) * (y_init[0] + 2 * np.sum(y_init[1:N_init-1]) + y_init[N_init-1])
I_simp_init= (stepsize_h_init / 3) * (y_init[0] + 2 * np.sum(y_init[:N_init-2:2]) + 4 * np.sum(y_init[1:N_init-1:2]) + y_init[N_init-1])

print("Initial calculation with N = 4:")
print("trapezoidal rule: ", I_trap_init)
print("simpsons rule:    ", I_simp_init)

#Q3(c)

#Finding n, N, value generated by trapezoidal rule, and the overall computation time in milliseconds for the trapezoidal approach
for n in range(2, 30):
    N = 2**n 
    h = (b - a) / N
    x = np.linspace(a, b, N + 1)
    y = func(x)
    
    t_start = time.perf_counter()
    I_trap_rule = (h / 2) * (y[0] + 2 * np.sum(y[1:N]) + y[N])
    t_end = time.perf_counter()
    
    err_trap = abs(I_trap_rule - true_val)
    ex_time_ms_trap = (t_end - t_start) * 1000 #Multiplied by 1000 to get miliseconds which has a higher accuracy
    
    if err_trap < target_err:
        print("Target reached at n =", n, "N =", N)
        print("Value calculated for trap:", I_trap_rule)
        print("Abs err for trap:", err_trap)
        print("Comp time for trap:", ex_time_ms_trap, "ms\n")
        break

#Finding n, N, value generated by simpsons rule, and the overall computation time in milliseconds for the simpsons approach
#used similar approach to that used in lab
for n in range(2, 30):
    N = 2**n 
    h = (b - a) / N
    x = np.linspace(a, b, N + 1)
    y = func(x)
    
    t_start = time.perf_counter()
    I_simp_rule = (h / 3) * (y[0] + 4 * np.sum(y[1:N:2]) + 2 * np.sum(y[2:N:2]) + y[N])
    t_end = time.perf_counter()
    
    err_simp = abs(I_simp_rule - true_val)
    ex_time_ms_simp = (t_end - t_start) * 1000 #Multiplied by 1000 to get miliseconds which has a higher accuracy
    
    if err_simp < target_err:
        print("Target reached at n =", n, "N =", N)
        print("Value calculated for simp:", I_simp_rule)
        print("Abs err for simp:", err_simp)
        print("Comp time for simp:", ex_time_ms_simp, "ms\n") #Multiplied by 1000 to get miliseconds which has a higher accuracy
        break

