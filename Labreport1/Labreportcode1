def std_err_3 (dataset):
    n = len(dataset)
    mean_dataset= ((np.sum(dataset)/n))
    var_sum = np.sum(dataset**2) 
    var_tot = ((var_sum - n*(mean_dataset)**2)) / (n-1)
    if var_tot <= 0:
        return 0
    std_err_3= sqrt(var_tot)
    return std_err_3
