def std_err_2 (dataset):
    n = len(dataset)
    mean_x= (np.sum(dataset)/n)
    var_2= np.sum((dataset-mean_x)**2)

    if var_2 <= 0:
        return 0
    std_err_2 = sqrt((var_2)/(n-1))
    return std_err_2

