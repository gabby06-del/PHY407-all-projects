# QUESTION 1(c): using math shifting idea for the one pass

def std_err_3_shifted (dataset):
    n = len(dataset)
    if n <= 1: return 0
    #using ka as the value that assigns the shift
    K = dataset[0]
    sum_w_shift = np.sum(dataset - K)
    sum_sq_w_shift = np.sum((dataset - K)**2)
    var_tot = (sum_sq_w_shift - (sum_w_shift**2) / n) / (n - 1)
    if var_tot <= 0:
        return 0
    return sqrt(var_tot)

